# Copy to docker/.env (gitignored). Referenced by docker-compose.multiprocess.yml.

# Discord + music API credentials
DISCORD_TOKEN=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
YOUTUBE_API_KEY=

# --- Mullvad WireGuard, for the gluetun tunnel (mullvad-socks5 egress) ---
# ONLY needed for `--profile vpn`. Leave blank for `--profile local`, which runs
# downloader-direct with no tunnel.
# From your Mullvad account: WireGuard configuration -> generate a key -> download
# any server's .conf and copy its PrivateKey + Address.
MULLVAD_WG_PRIVATE_KEY=
MULLVAD_WG_ADDRESSES=10.x.x.x/32
# Tunnel entry server(s), comma-separated. The per-download *exits* are set in
# music.download.egress_exits in volumes/cnf/discord.downloader.cnf.
MULLVAD_ENTRY_HOSTNAMES=us-nyc-wg-301
