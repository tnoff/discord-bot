# HA bot config — for docker/docker-compose.multiprocess.yml (bot service).
# Entrypoint: discord-gateway (cli.bot). Cogs run here; all Discord REST
# calls are forwarded to the dispatcher pod over HTTP.
#
# Secrets resolve from env vars via pyaml_env. Set them in docker/.env
# (gitignored). Required:
#   DISCORD_TOKEN, SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET, YOUTUBE_API_KEY
general:
  discord_token: !ENV ${DISCORD_TOKEN}
  sql_connection_statement: postgresql://discord:discord@postgres:5432/discord
  dispatch_http_url: http://dispatcher:8082
  commands_http_url: http://commands:8086
  monitoring:
    otlp:
      enabled: false
    health_server:
      enabled: true
      port: 8080
  include:
    default: true
    markov: true
    music: true
music:
  # REQUIRED: the gateway is a client of the broker and has no in-process fallback
  # (projects/discord-bot-ha-only). A missing url is a startup error. It holds no
  # downloader or search client: the commands pod (discord.commands.cnf.example)
  # reaches those. Old music.download_client / youtube_music_search_client /
  # media_search_client blocks left in this file are ignored.
  broker_client:
    url: http://broker:8081
  download:
    spotify_credentials:
      client_id: !ENV ${SPOTIFY_CLIENT_ID}
      client_secret: !ENV ${SPOTIFY_CLIENT_SECRET}
    youtube_api_key: !ENV ${YOUTUBE_API_KEY}
