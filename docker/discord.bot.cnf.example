# HA bot config — for docker/docker-compose.multiprocess.yml (bot service).
# Entrypoint: discord-bot-min (cli.bot). Cogs run here; all Discord REST
# calls are forwarded to the dispatcher pod over HTTP.
#
# Secrets resolve from env vars via pyaml_env. Set them in docker/.env
# (gitignored). Required:
#   DISCORD_TOKEN, SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET, YOUTUBE_API_KEY
general:
  discord_token: !ENV ${DISCORD_TOKEN}
  sql_connection_statement: postgresql://discord:discord@postgres:5432/discord
  dispatch_http_url: http://dispatcher:8082
  monitoring:
    otlp:
      enabled: false
    health_server:
      enabled: true
      port: 8080
  include:
    default: true
    markov: true
    delete_messages: true
    music: true
music:
  # HA download path: enqueue to the standalone downloader + read results from the
  # broker instead of downloading in-process. download_client.url points at the
  # downloader's HTTP server, reached via gluetun (the downloader shares its netns).
  broker_client:
    url: http://broker:8081
  download_client:
    url: http://gluetun:8083
  # HA search path: submit/clear/block searches against the standalone search pod
  # instead of running the search loop in-process. Resolutions come back through
  # the broker's search-result queue, the same way download results do. Drop this
  # key to fall back to the in-process worker (the search service then has no
  # producer and idles).
  youtube_music_search_client:
    url: http://search:8084
  download:
    spotify_credentials:
      client_id: !ENV ${SPOTIFY_CLIENT_ID}
      client_secret: !ENV ${SPOTIFY_CLIENT_SECRET}
    youtube_api_key: !ENV ${YOUTUBE_API_KEY}
