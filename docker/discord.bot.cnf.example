# HA bot config — for docker/docker-compose.multiprocess.yml (bot service).
# Entrypoint: discord-bot-min (cli.bot). Cogs run here; all Discord REST
# calls are forwarded to the dispatcher pod over HTTP.
#
# Secrets resolve from env vars via pyaml_env. Set them in docker/.env
# (gitignored). Required:
#   DISCORD_TOKEN, SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET, YOUTUBE_API_KEY
general:
  discord_token: !ENV ${DISCORD_TOKEN}
  sql_connection_statement: postgresql://discord:discord@postgres:5432/discord
  dispatch_http_url: http://dispatcher:8082
  monitoring:
    otlp:
      enabled: false
    health_server:
      enabled: true
      port: 8080
  include:
    default: true
    markov: true
    delete_messages: true
    music: true
music:
  # All three of these keys are REQUIRED: the bot is a client of the broker,
  # downloader and search pods and has no in-process fallback for any of them
  # (projects/discord-bot-ha-only). A missing url is a startup error.
  #
  # download_client.url points at the
  # "downloader-host" network alias, which resolves to whichever downloader
  # flavour is up — downloader-direct (profile "local") or gluetun, whose netns
  # downloader-vpn shares (profile "vpn"). Same URL either way.
  broker_client:
    url: http://broker:8081
  download_client:
    url: http://downloader-host:8083
  # HA search path: submit/clear/block searches against the standalone search pod.
  # Resolutions come back through the broker's search-result queue, the same way
  # download results do.
  youtube_music_search_client:
    url: http://search:8084
  download:
    spotify_credentials:
      client_id: !ENV ${SPOTIFY_CLIENT_ID}
      client_secret: !ENV ${SPOTIFY_CLIENT_SECRET}
    youtube_api_key: !ENV ${YOUTUBE_API_KEY}
