FROM python:3.14-slim-bookworm


# Setup venv
ENV APPDIR="/opt/packages/discord-bot"
ENV WORKDIR="/opt/discord"
ENV VENVDIR="/opt/discord-venv"
ENV LOGFILE="/var/log/discord"

# Setup installs and create directory structure
RUN mkdir -p "${APPDIR}" "${WORKDIR}" "${LOGFILE}" \
    "${WORKDIR}/cnf" "${WORKDIR}/downloads" "${WORKDIR}/db"

# Create non-root user and group
# Using UID/GID 1000 which is common for first user on many systems
# Home directory is /opt/discord (the working directory)
RUN groupadd -g 1000 discord && \
    useradd -r -u 1000 -g discord -s /bin/bash -d /opt/discord discord

# No alembic/ or alembic.ini, unlike the bot and broker images. The
# dispatcher's own dependencies (discord.py only) have neither alembic nor
# sqlalchemy -- so this image could never have run a migration. It carried
# the files anyway, and because they were also installed into site-packages as
# a namespace package, `import alembic` SUCCEEDED here while the library was
# absent. That is a worse failure than not shipping them: it answers "is
# alembic available?" with yes.
# ---- dependency layer: keyed on pyproject.toml alone ----
# VERSION is deliberately NOT copied here. It is bumped by essentially every MR
# (the changelog.d workflow), so including it busts this layer on every change
# and the expensive install re-runs for a version string. Measured before this
# split: a VERSION-only bump re-ran the install at 25.2s on this image, 43.9s on
# the broker and 146.5s on the downloader, while the bot image -- which already
# did this -- cost 10s.
#
# Two packages now, not one: criterion 8 step 5 gave discord_core and each pod
# its own pyproject.toml. setuptools resolves each one's version via
# `[tool.setuptools.dynamic]` and will not build without a VERSION file present
# in ITS OWN directory (setuptools refuses to read outside a package's own
# root), so a STUB package plus a placeholder VERSION satisfies each. The real
# ones arrive in the source layer below.
COPY discord_core/pyproject.toml "${APPDIR}/discord_core/pyproject.toml"
COPY discord_dispatcher/pyproject.toml "${APPDIR}/discord_dispatcher/pyproject.toml"

# INSTALL_HEAPTRACK bakes the native heap profiler in for a diagnostic build
# (default off) — see docker/entrypoint.sh + the :heaptrack CI job.
ARG INSTALL_HEAPTRACK=false
RUN if [ "$INSTALL_HEAPTRACK" = "true" ]; then \
        apt-get update && \
        apt-get install -y --no-install-recommends heaptrack && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# No git needed: the dispatcher's own package has no `git+https` VCS dep
# (that's discord_gateway's dappertable). Installs discord_core (the shared
# set) plus discord_dispatcher's own (discord.py only) -- both path installs,
# not extras: there is no longer one pyproject.toml with a [dispatcher] extra
# to name.
RUN mkdir -p "${APPDIR}/discord_core" "${APPDIR}/discord_dispatcher" && \
    : > "${APPDIR}/discord_core/__init__.py" && \
    : > "${APPDIR}/discord_dispatcher/__init__.py" && \
    echo "0.0.0" > "${APPDIR}/discord_core/VERSION" && \
    echo "0.0.0" > "${APPDIR}/discord_dispatcher/VERSION" && \
    pip install "${APPDIR}/discord_core" "${APPDIR}/discord_dispatcher" && \
    pip uninstall -y discord-core discord-dispatcher

# ---- source layer: the actual packages ----
# --no-deps because the layer above already resolved every third-party
# requirement. The stubs are UNINSTALLED up there rather than overwritten here:
# leaving them produced both a 0.0.0 dist-info and the real one, and
# `importlib.metadata.version()` resolved to the 0.0.0. Nothing reads the
# version at runtime today, but the image would have reported the wrong one.
# discord_core/ is its own top-level package as of criterion 8 step 2, so it
# needs its own line -- copying the legacy root no longer brings the core along.
# One COPY per root rather than `COPY . ${APPDIR}` on purpose: the whole point
# of the split is that an image carries the roots it reaches and no others.
# discord_dispatcher/ replaces the legacy root as of criterion 8 step 4: the
# pod's own code no longer lives there at all, so this image drops that line
# entirely rather than keeping it alongside the new one. Each COPY brings its
# own real VERSION symlink (-> ../VERSION), which is why the plain `COPY
# VERSION` below has to land before the install, not after: the symlink target
# does not exist until it does.
COPY discord_dispatcher/ "${APPDIR}/discord_dispatcher/"
COPY discord_core/ "${APPDIR}/discord_core/"
COPY VERSION "${APPDIR}/"
# CORE_TAG pins discord_core to a tagged release tarball instead of the local
# checkout (criterion 8 step 7 / #1011). Default empty means every existing
# build path -- a plain `docker build`, docker compose, and the PR-time
# docker-build-check.yml job -- is unaffected: none of them ever pass this
# arg, so they keep installing discord_core from ${APPDIR} like today. A PR
# needs to build an image containing its own uncommitted discord_core
# changes, so the path install has to stay the default; only a real release
# build (release.yml, after package-tags has pushed the tag) passes CORE_TAG.
ARG CORE_TAG=""
RUN if [ -n "$CORE_TAG" ]; then \
      pip install --no-deps \
        "discord-core @ https://github.com/tnoff/discord-bot/archive/refs/tags/${CORE_TAG}.tar.gz#subdirectory=discord_core" \
        "${APPDIR}/discord_dispatcher"; \
    else \
      pip install --no-deps "${APPDIR}/discord_core" "${APPDIR}/discord_dispatcher"; \
    fi

# Set ownership of directories that need to be writable by the discord user
# Must be done BEFORE switching to discord user
RUN chown -R discord:discord "${WORKDIR}" "${LOGFILE}"

# Route through the shared entrypoint so HEAPTRACK_ENABLE=true launches the
# process under heaptrack (parity with the bot image). DISCORD_BOT_CMD selects
# the dispatcher console script; behaviour is identical to the old direct
# ENTRYPOINT (the process is still selected by the command, not a config flag).
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV DISCORD_BOT_CMD=discord-dispatcher

EXPOSE 8080 8082

WORKDIR "/opt/discord"

# Switch to non-root user for runtime
USER discord

# Make sure cache dir exists
RUN mkdir -p /opt/discord/.cache

# Probe the dispatch HTTP server (port 8082) — it's the API the bot pods
# call. The /health endpoint on port 8080 only reflects redis reachability,
# and starts listening before the dispatch server does.
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD python3 -c "import socket; socket.create_connection(('localhost', 8082), timeout=5).close()"

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/opt/discord/cnf/discord.cnf"]
