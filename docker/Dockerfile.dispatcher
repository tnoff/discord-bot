FROM python:3.14-slim-bookworm


# Setup venv
ENV APPDIR="/opt/packages/discord-bot"
ENV WORKDIR="/opt/discord"
ENV VENVDIR="/opt/discord-venv"
ENV LOGFILE="/var/log/discord"

# Setup installs and create directory structure
RUN mkdir -p "${APPDIR}" "${WORKDIR}" "${LOGFILE}" \
    "${WORKDIR}/cnf" "${WORKDIR}/downloads" "${WORKDIR}/db"

# Create non-root user and group
# Using UID/GID 1000 which is common for first user on many systems
# Home directory is /opt/discord (the working directory)
RUN groupadd -g 1000 discord && \
    useradd -r -u 1000 -g discord -s /bin/bash -d /opt/discord discord

# No alembic/ or alembic.ini, unlike the bot and broker images. The
# dispatcher's own dependencies (discord.py only) have neither alembic nor
# sqlalchemy -- so this image could never have run a migration. It carried
# the files anyway, and because they were also installed into site-packages as
# a namespace package, `import alembic` SUCCEEDED here while the library was
# absent. That is a worse failure than not shipping them: it answers "is
# alembic available?" with yes.
# ---- dependency layer: keyed on pyproject.toml alone ----
# VERSION is deliberately NOT copied here. It is bumped by essentially every MR
# (the changelog.d workflow), so including it busts this layer on every change
# and the expensive install re-runs for a version string. Measured before this
# split: a VERSION-only bump re-ran the install at 25.2s on this image, 43.9s on
# the broker and 146.5s on the downloader, while the bot image -- which already
# did this -- cost 10s.
#
# One stub package now, not two: criterion 8 step 7 gave discord_dispatcher a
# real, declared `discord-core @ <tagged tarball>` dependency in its own
# pyproject.toml, so installing the stub below pulls discord_core in
# transitively from that pinned release. setuptools resolves the version via
# `[tool.setuptools.dynamic]` and will not build without a VERSION file
# present in the package's own directory (setuptools refuses to read outside
# a package's own root), so a STUB package plus a placeholder VERSION
# satisfies it. The real one arrives in the source layer below.
COPY discord_dispatcher/pyproject.toml "${APPDIR}/discord_dispatcher/pyproject.toml"

# No git needed: the dispatcher's own package has no `git+https` VCS dep
# (that's discord_gateway's dappertable). Installs discord_dispatcher's own
# declared dependencies (discord.py, and now discord_core too, pulled from its
# pinned tag rather than this checkout) -- a path install, not an extra:
# there is no longer one pyproject.toml with a [dispatcher] extra to name.
RUN mkdir -p "${APPDIR}/discord_dispatcher" && \
    : > "${APPDIR}/discord_dispatcher/__init__.py" && \
    echo "0.0.0" > "${APPDIR}/discord_dispatcher/VERSION" && \
    pip install "${APPDIR}/discord_dispatcher" && \
    pip uninstall -y discord-dispatcher

# ---- source layer: the actual package ----
# --no-deps because the layer above already resolved every third-party
# requirement -- including discord_core, pulled transitively from its pinned
# tag. The stub is UNINSTALLED up there rather than overwritten here: leaving
# it produced both a 0.0.0 dist-info and the real one, and
# `importlib.metadata.version()` resolved to the 0.0.0. Nothing reads the
# version at runtime today, but the image would have reported the wrong one.
# discord_core is NOT installed here: it already arrived in the layer above
# from the pinned release tarball named in discord_dispatcher's own
# pyproject.toml, not from this checkout. There is no local-path install of
# discord_core in this image any more, in any context (dev build, PR CI or a
# real release push) -- see per-image-code-split.md criterion 8 step 7.
# discord_dispatcher/ replaces the legacy root as of criterion 8 step 4: the
# pod's own code no longer lives there at all, so this image drops that line
# entirely rather than keeping it alongside the new one.
COPY discord_dispatcher/ "${APPDIR}/discord_dispatcher/"
RUN pip install --no-deps "${APPDIR}/discord_dispatcher"

# Set ownership of directories that need to be writable by the discord user
# Must be done BEFORE switching to discord user
RUN chown -R discord:discord "${WORKDIR}" "${LOGFILE}"

# Route through the shared entrypoint. DISCORD_BOT_CMD selects
# the dispatcher console script; behaviour is identical to the old direct
# ENTRYPOINT (the process is still selected by the command, not a config flag).
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV DISCORD_BOT_CMD=discord-dispatcher

EXPOSE 8080 8082

WORKDIR "/opt/discord"

# Switch to non-root user for runtime
USER discord

# Make sure cache dir exists
RUN mkdir -p /opt/discord/.cache

# Probe the dispatch HTTP server (port 8082) — it's the API the bot pods
# call. The /health endpoint on port 8080 only reflects redis reachability,
# and starts listening before the dispatch server does.
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD python3 -c "import socket; socket.create_connection(('localhost', 8082), timeout=5).close()"

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/opt/discord/cnf/discord.cnf"]
