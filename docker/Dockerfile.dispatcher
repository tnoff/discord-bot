FROM python:3.14-slim-bookworm


# Setup venv
ENV APPDIR="/opt/packages/discord-bot"
ENV WORKDIR="/opt/discord"
ENV VENVDIR="/opt/discord-venv"
ENV LOGFILE="/var/log/discord"

# Setup installs and create directory structure
RUN mkdir -p "${APPDIR}" "${WORKDIR}" "${LOGFILE}" \
    "${WORKDIR}/cnf" "${WORKDIR}/downloads" "${WORKDIR}/db"

# Create non-root user and group
# Using UID/GID 1000 which is common for first user on many systems
# Home directory is /opt/discord (the working directory)
RUN groupadd -g 1000 discord && \
    useradd -r -u 1000 -g discord -s /bin/bash -d /opt/discord discord

# No alembic/ or alembic.ini, unlike the bot and broker images. [dispatcher]
# is discord_bot[gateway] -- the core set plus discord.py, with neither alembic
# nor sqlalchemy -- so this image could never have run a migration. It carried
# the files anyway, and because they were also installed into site-packages as
# a namespace package, `import alembic` SUCCEEDED here while the library was
# absent. That is a worse failure than not shipping them: it answers "is
# alembic available?" with yes.
# ---- dependency layer: keyed on pyproject.toml alone ----
# VERSION is deliberately NOT copied here. It is bumped by essentially every MR
# (the changelog.d workflow), so including it busts this layer on every change
# and the expensive install re-runs for a version string. Measured before this
# split: a VERSION-only bump re-ran the install at 25.2s on this image, 43.9s on
# the broker and 146.5s on the downloader, while the bot image -- which already
# did this -- cost 10s.
#
# setuptools resolves the version via `[tool.setuptools.dynamic]` and will not
# build without the file, so a STUB package and a placeholder VERSION satisfy
# the dependency resolve. The real ones arrive in the source layer below.
COPY pyproject.toml "${APPDIR}/"

# INSTALL_HEAPTRACK bakes the native heap profiler in for a diagnostic build
# (default off) — see docker/entrypoint.sh + the :heaptrack CI job.
ARG INSTALL_HEAPTRACK=false
RUN if [ "$INSTALL_HEAPTRACK" = "true" ]; then \
        apt-get update && \
        apt-get install -y --no-install-recommends heaptrack && \
        rm -rf /var/lib/apt/lists/*; \
    fi

# No git needed: the dispatcher installs base deps only (no `[bot]`), and the
# base dependency set has no `git+https` VCS dep (that's `[bot]`'s dappertable).
# Installs [dispatcher] -- the core set plus discord.py. It used to install no
# extra at all, so "base deps only" was a habit rather than a declaration; now
# the image names what it needs, like the other four.
RUN mkdir -p "${APPDIR}/discord_bot" && \
    : > "${APPDIR}/discord_bot/__init__.py" && \
    echo "0.0.0" > "${APPDIR}/VERSION" && \
    pip install "${APPDIR}[dispatcher]" && \
    pip uninstall -y discord_bot

# ---- source layer: the actual package ----
# --no-deps because the layer above already resolved every third-party
# requirement. The stub is UNINSTALLED up there rather than overwritten here:
# leaving it produced both a discord_bot-0.0.0.dist-info and the real one, and
# `importlib.metadata.version()` resolved to the 0.0.0. Nothing reads the
# version at runtime today, but the image would have reported the wrong one.
# discord_core/ is its own top-level package as of criterion 8 step 2, so it
# needs its own COPY -- `COPY discord_bot/` no longer brings the core along.
# One COPY per root rather than `COPY . ${APPDIR}` on purpose: the whole point
# of the split is that an image carries the roots it reaches and no others.
COPY discord_bot/ "${APPDIR}/discord_bot/"
COPY discord_core/ "${APPDIR}/discord_core/"
COPY discord_seam_dispatch/ "${APPDIR}/discord_seam_dispatch/"
COPY VERSION "${APPDIR}/"
RUN pip install --no-deps "${APPDIR}[dispatcher]"

# Set ownership of directories that need to be writable by the discord user
# Must be done BEFORE switching to discord user
RUN chown -R discord:discord "${WORKDIR}" "${LOGFILE}"

# Route through the shared entrypoint so HEAPTRACK_ENABLE=true launches the
# process under heaptrack (parity with the bot image). DISCORD_BOT_CMD selects
# the dispatcher console script; behaviour is identical to the old direct
# ENTRYPOINT (the process is still selected by the command, not a config flag).
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV DISCORD_BOT_CMD=discord-dispatcher

EXPOSE 8080 8082

WORKDIR "/opt/discord"

# Switch to non-root user for runtime
USER discord

# Make sure cache dir exists
RUN mkdir -p /opt/discord/.cache

# Probe the dispatch HTTP server (port 8082) — it's the API the bot pods
# call. The /health endpoint on port 8080 only reflects redis reachability,
# and starts listening before the dispatch server does.
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD python3 -c "import socket; socket.create_connection(('localhost', 8082), timeout=5).close()"

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/opt/discord/cnf/discord.cnf"]
