# Commands pod config — for docker/docker-compose.multiprocess.yml (commands service).
# Entrypoint: discord-commands (cli.commands). No gateway connection and no Discord token;
# only the CommandsHttpServer on :8086. Replies go out through the dispatcher.
general:
  dispatch_http_url: http://dispatcher:8082
  # The markov and playlist commands read and write through the db pod.
  database_http_url: http://db:8085
  commands_server:
    host: 0.0.0.0
    port: 8086
  monitoring:
    otlp:
      enabled: false
    health_server:
      enabled: true
      port: 8080
# Read by the music and playlist commands (the same keys the gateway reads).
music:
  general:
    message_delete_after: 300
  playlist:
    server_playlist_max_size: 64
  player:
    queue_max_size: 128
  # The pods the music commands reach: the play queue and gateway intents (broker), downloads
  # (downloader) and search (search pod, which serves both search clients).
  broker_client:
    url: http://broker:8081
  download_client:
    url: http://downloader-host:8083
  youtube_music_search_client:
    url: http://search:8084
  media_search_client:
    url: http://search:8084
