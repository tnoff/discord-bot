# Commands pod config — for docker/docker-compose.multiprocess.yml (commands service).
# Entrypoint: discord-commands (cli.commands). No gateway connection and no Discord token;
# only the CommandsHttpServer on :8086. Replies go out through the dispatcher.
general:
  dispatch_http_url: http://dispatcher:8082
  # The markov commands read and write through the db pod.
  database_http_url: http://db:8085
  commands_server:
    host: 0.0.0.0
    port: 8086
  monitoring:
    otlp:
      enabled: false
    health_server:
      enabled: true
      port: 8080
