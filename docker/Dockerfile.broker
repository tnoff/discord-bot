FROM python:3.14-slim-bookworm


# Setup venv
ENV APPDIR="/opt/packages/discord-bot"
ENV WORKDIR="/opt/discord"
ENV VENVDIR="/opt/discord-venv"
ENV LOGFILE="/var/log/discord"

# Setup installs and create directory structure
RUN mkdir -p "${APPDIR}" "${WORKDIR}" "${LOGFILE}" \
    "${WORKDIR}/cnf" "${WORKDIR}/downloads" "${WORKDIR}/db"

# Create non-root user and group
# Using UID/GID 1000 which is common for first user on many systems
# Home directory is /opt/discord (the working directory)
RUN groupadd -g 1000 discord && \
    useradd -r -u 1000 -g discord -s /bin/bash -d /opt/discord discord

# No alembic/ or alembic.ini. Unlike the bot image (one builder stage, one
# runtime stage) this one is single-stage, so ${APPDIR} IS the shipped
# filesystem: 88 KB of migration scripts were riding along in the image with
# no alembic to run them from the moment #927 dropped [database]. The size is
# beside the point -- the files claimed a capability the image doesn't have.
# ---- dependency layer: keyed on pyproject.toml alone ----
# VERSION is deliberately NOT copied here. It is bumped by essentially every MR
# (the changelog.d workflow), so including it busts this layer on every change
# and the expensive install re-runs for a version string. Measured on the
# dispatcher before and after this split: 24.4s -> 9.6s on a VERSION-only bump.
#
# Two packages now, not one: criterion 8 step 5 gave discord_core and each pod
# its own pyproject.toml. setuptools resolves each one's version via
# `[tool.setuptools.dynamic]` and will not build without a VERSION file present
# in ITS OWN directory (setuptools refuses to read outside a package's own
# root), so a STUB package plus a placeholder VERSION satisfies each. The real
# ones arrive in the source layer below.
COPY discord_core/pyproject.toml "${APPDIR}/discord_core/pyproject.toml"
COPY discord_broker/pyproject.toml "${APPDIR}/discord_broker/pyproject.toml"

# Installs discord_core (the shared set: boto3 for the S3 checkout is here now,
# not on this package) plus discord_broker's own (dappertable, for bundle
# rendering) -- both path installs, not extras. NOT SQLAlchemy, asyncpg or
# alembic -- the video-cache catalog is read over HTTP from the db pod as of
# #927, so this image holds no database engine at all. It used to install
# [bot], which meant carrying yt-dlp and all three search clients into a pod
# that neither downloads nor searches. Both packages' own deps now match the
# measured import set; the import boundary in
# tests/cli/test_import_boundaries.py asserts the other direction.
# INSTALL_HEAPTRACK bakes the native heap profiler in for a diagnostic build
# (default off) — see docker/entrypoint.sh + the :heaptrack CI job.
ARG INSTALL_HEAPTRACK=false
RUN apt-get update && \
    apt-get install -y --no-install-recommends git && \
    if [ "$INSTALL_HEAPTRACK" = "true" ]; then \
        apt-get install -y --no-install-recommends heaptrack; \
    fi && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p "${APPDIR}/discord_core" "${APPDIR}/discord_broker" && \
    : > "${APPDIR}/discord_core/__init__.py" && \
    : > "${APPDIR}/discord_broker/__init__.py" && \
    echo "0.0.0" > "${APPDIR}/discord_core/VERSION" && \
    echo "0.0.0" > "${APPDIR}/discord_broker/VERSION" && \
    pip install "${APPDIR}/discord_core" "${APPDIR}/discord_broker" && \
    pip uninstall -y discord-core discord-broker && \
    apt-get remove -y git && apt-get autoremove -y

# ---- source layer: the actual packages ----
# --no-deps because the layer above already resolved every third-party
# requirement. The stubs are UNINSTALLED up there rather than overwritten here:
# leaving them produced both a 0.0.0 dist-info and the real one, and
# `importlib.metadata.version()` resolved to the 0.0.0.
# discord_core/ is its own top-level package as of criterion 8 step 2, so it
# needs its own line -- copying the legacy root no longer brings the core along.
# One COPY per root rather than `COPY . ${APPDIR}` on purpose: the whole point
# of the split is that an image carries the roots it reaches and no others.
# discord_broker/ replaces the legacy root as of criterion 8 step 4: the pod's
# own code no longer lives there at all, so this image drops that line
# entirely rather than keeping it alongside the new one. The broker SEAM
# (the contract broker's own server implements) folded into discord_core/
# as of criterion 8's seam-fold reversal, so there is no longer a separate
# line for it here -- discord_core/ above already carries it. Each COPY brings
# its own real VERSION symlink (-> ../VERSION), which is why the plain `COPY
# VERSION` below has to land before the install, not after: the symlink target
# does not exist until it does.
COPY discord_broker/ "${APPDIR}/discord_broker/"
COPY discord_core/ "${APPDIR}/discord_core/"
COPY VERSION "${APPDIR}/"
RUN pip install --no-deps "${APPDIR}/discord_core" "${APPDIR}/discord_broker"

# Set ownership of directories that need to be writable by the discord user
# Must be done BEFORE switching to discord user
RUN chown -R discord:discord "${WORKDIR}" "${LOGFILE}"

# Route through the shared entrypoint so HEAPTRACK_ENABLE=true launches the
# process under heaptrack (parity with the bot image). DISCORD_BOT_CMD selects
# the broker console script; behaviour is identical to the old direct ENTRYPOINT.
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV DISCORD_BOT_CMD=discord-broker

EXPOSE 8080 8081

WORKDIR "/opt/discord"

# Switch to non-root user for runtime
USER discord

# Make sure cache dir exists
RUN mkdir -p /opt/discord/.cache

# Probe the broker HTTP server (port 8081) — the API bot pods call. The
# /health endpoint on port 8080 only reflects redis reachability and starts
# listening before the broker server does.
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD python3 -c "import socket; socket.create_connection(('localhost', 8081), timeout=5).close()"

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/opt/discord/cnf/discord.cnf"]
