FROM python:3.14-slim-bookworm

# Standalone downloader pod — yt-dlp + ffmpeg + deno + S3 upload.
# Runs the redis-backed download queue consumer + DownloadHttpServer; no gateway
# connection.  Installs the full [bot] extra: the download pipeline needs boto3
# for S3 upload and yt-dlp/ffmpeg/deno for the actual downloads.  No git needed —
# the only VCS dep (dappertable) is pinned to a GitLab release tarball URL.

# Setup venv
ENV APPDIR="/opt/packages/discord-bot"
ENV WORKDIR="/opt/discord"
ENV VENVDIR="/opt/discord-venv"
ENV LOGFILE="/var/log/discord"
ENV DENO_INSTALL_ROOT="/opt/discord/.deno"

# Setup installs and create directory structure
RUN mkdir -p "${APPDIR}" "${WORKDIR}" "${LOGFILE}" \
    "${WORKDIR}/cnf" "${WORKDIR}/downloads"

# Create non-root user and group
# Using UID/GID 1000 which matches the bot/broker images for shared volume perms.
# Home directory is /opt/discord (the working directory)
RUN groupadd -g 1000 discord && \
    useradd -r -u 1000 -g discord -s /bin/bash -d /opt/discord discord

# ---- dependency layer: keyed on pyproject.toml alone ----
# VERSION is deliberately NOT copied here. It is bumped by essentially every MR
# (the changelog.d workflow), so including it busts this layer on every change
# and the expensive install re-runs for a version string. Measured on the
# dispatcher before and after this split: 24.4s -> 9.6s on a VERSION-only bump.
#
# One stub package now, not two: criterion 8 step 7 gave discord_downloader a
# real, declared `discord-core @ <tagged tarball>` dependency in its own
# pyproject.toml, so installing the stub below pulls discord_core in
# transitively from that pinned release. setuptools resolves the version via
# `[tool.setuptools.dynamic]` and will not build without a VERSION file
# present in the package's own directory (setuptools refuses to read outside
# a package's own root), so a STUB package plus a placeholder VERSION
# satisfies it. The real one arrives in the source layer below.
COPY discord_downloader/pyproject.toml "${APPDIR}/discord_downloader/pyproject.toml"

# Single layer: install build + runtime apt packages, pip install
# discord_downloader's own declared dependencies (yt-dlp, and now discord_core
# too -- pulled from its pinned tag rather than this checkout; no git, and no
# dappertable/SQLAlchemy/search clients — it used to install [bot] and carry
# all of them), deno, then purge build-only packages plus the mesa/LLVM stack
# that ffmpeg pulls in transitively through libGL's lazy GLX provider chain
# (libGL -> libglx-mesa0 -> libgl1-mesa-dri -> libllvm15).  Audio-only ffmpeg
# never triggers that chain, so removing the JIT (libllvm15, 115 MB) and the DRI
# driver (libgl1-mesa-dri, 25 MB) is safe.
ARG INSTALL_HEAPTRACK=false
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      gcc cmake ffmpeg curl unzip ca-certificates && \
    if [ "$INSTALL_HEAPTRACK" = "true" ]; then \
      apt-get install -y --no-install-recommends heaptrack; \
    fi && \
    mkdir -p "${APPDIR}/discord_downloader" && \
    : > "${APPDIR}/discord_downloader/__init__.py" && \
    echo "0.0.0" > "${APPDIR}/discord_downloader/VERSION" && \
    pip install --no-cache-dir "${APPDIR}/discord_downloader" && \
    pip uninstall -y discord-downloader && \
    curl -fsSL https://deno.land/install.sh \
      | DENO_INSTALL="${DENO_INSTALL_ROOT}" sh && \
    chown -R discord:discord "${WORKDIR}" "${LOGFILE}" && \
    apt-get purge -y --auto-remove gcc cmake curl unzip && \
    dpkg --remove --force-depends libllvm15 libgl1-mesa-dri && \
    rm -rf /var/lib/apt/lists/* /root/.cache

# ---- source layer: the actual package ----
# --no-deps because the layer above already resolved every third-party
# requirement -- including discord_core, pulled transitively from its pinned
# tag. The stub is UNINSTALLED up there rather than overwritten here: leaving
# it produced both a 0.0.0 dist-info and the real one, and
# `importlib.metadata.version()` resolved to the 0.0.0.
#
# `rm -rf "${APPDIR}"` moved down here from the layer above. It has to run AFTER
# the real install, not before it -- deleting the directory in the dependency
# layer would leave this one with nothing to install from.
# discord_core is NOT installed here: it already arrived in the layer above
# from the pinned release tarball named in discord_downloader's own
# pyproject.toml, not from this checkout. There is no local-path install of
# discord_core in this image any more, in any context (dev build, PR CI or a
# real release push) -- see per-image-code-split.md criterion 8 step 7.
# discord_downloader/ replaces the legacy root as of criterion 8 step 4: the
# pod's own code no longer lives there at all, so this image drops that line
# entirely rather than keeping it alongside the new one. The real VERSION
# symlink (-> ../VERSION) is why the plain `COPY VERSION` below has to land
# before the install, not after: the symlink target does not exist until it
# does.
COPY discord_downloader/ "${APPDIR}/discord_downloader/"
COPY VERSION "${APPDIR}/"
RUN pip install --no-cache-dir --no-deps "${APPDIR}/discord_downloader" && \
    rm -rf "${APPDIR}" /root/.cache

ENV PATH="$PATH:/opt/discord/.deno/bin"

# Route through the shared entrypoint so HEAPTRACK_ENABLE=true launches the
# process under heaptrack (parity with the bot image; the INSTALL_HEAPTRACK arg
# above bakes the binary in). DISCORD_BOT_CMD selects the downloader console
# script; behaviour is identical to the old direct ENTRYPOINT.
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV DISCORD_BOT_CMD=discord-downloader

EXPOSE 8080 8083

WORKDIR "/opt/discord"

# Switch to non-root user for runtime
USER discord

# Make sure cache dir exists
RUN mkdir -p /opt/discord/.cache

# Probe the download HTTP server (port 8083) — the bot pods call. The /health
# endpoint on port 8080 only reflects redis reachability and starts listening
# before the download server does.
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD python3 -c "import socket; socket.create_connection(('localhost', 8083), timeout=5).close()"

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/opt/discord/cnf/discord.cnf"]
