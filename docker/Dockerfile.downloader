FROM python:3.14-slim-bookworm

# Standalone downloader pod — yt-dlp + ffmpeg + deno + S3 upload.
# Runs the redis-backed download queue consumer + DownloadHttpServer; no gateway
# connection.  Installs the full [bot] extra: the download pipeline needs boto3
# for S3 upload and yt-dlp/ffmpeg/deno for the actual downloads.  No git needed —
# the only VCS dep (dappertable) is pinned to a GitLab release tarball URL.

# Setup venv
ENV APPDIR="/opt/packages/discord-bot"
ENV WORKDIR="/opt/discord"
ENV VENVDIR="/opt/discord-venv"
ENV LOGFILE="/var/log/discord"
ENV DENO_INSTALL_ROOT="/opt/discord/.deno"

# Setup installs and create directory structure
RUN mkdir -p "${APPDIR}" "${WORKDIR}" "${LOGFILE}" \
    "${WORKDIR}/cnf" "${WORKDIR}/downloads"

# Create non-root user and group
# Using UID/GID 1000 which matches the bot/broker images for shared volume perms.
# Home directory is /opt/discord (the working directory)
RUN groupadd -g 1000 discord && \
    useradd -r -u 1000 -g discord -s /bin/bash -d /opt/discord discord

COPY discord_bot/ "${APPDIR}/discord_bot/"
COPY pyproject.toml VERSION "${APPDIR}/"

# Single layer: install build + runtime apt packages, pip install the [bot]
# extra (no git — dappertable is a release-tarball URL), install deno, then purge
# build-only packages plus the mesa/LLVM stack
# that ffmpeg pulls in transitively through libGL's lazy GLX provider chain
# (libGL -> libglx-mesa0 -> libgl1-mesa-dri -> libllvm15).  Audio-only ffmpeg
# never triggers that chain, so removing the JIT (libllvm15, 115 MB) and the DRI
# driver (libgl1-mesa-dri, 25 MB) is safe.
ARG INSTALL_HEAPTRACK=false
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      gcc cmake ffmpeg curl unzip ca-certificates && \
    if [ "$INSTALL_HEAPTRACK" = "true" ]; then \
      apt-get install -y --no-install-recommends heaptrack; \
    fi && \
    pip install --no-cache-dir "${APPDIR}[bot]" && \
    curl -fsSL https://deno.land/install.sh \
      | DENO_INSTALL="${DENO_INSTALL_ROOT}" sh && \
    chown -R discord:discord "${WORKDIR}" "${LOGFILE}" && \
    apt-get purge -y --auto-remove gcc cmake curl unzip && \
    dpkg --remove --force-depends libllvm15 libgl1-mesa-dri && \
    rm -rf "${APPDIR}" /var/lib/apt/lists/* /root/.cache

ENV PATH="$PATH:/opt/discord/.deno/bin"

# Route through the shared entrypoint so HEAPTRACK_ENABLE=true launches the
# process under heaptrack (parity with the bot image; the INSTALL_HEAPTRACK arg
# above bakes the binary in). DISCORD_BOT_CMD selects the downloader console
# script; behaviour is identical to the old direct ENTRYPOINT.
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV DISCORD_BOT_CMD=discord-downloader

EXPOSE 8080 8083

WORKDIR "/opt/discord"

# Switch to non-root user for runtime
USER discord

# Make sure cache dir exists
RUN mkdir -p /opt/discord/.cache

# Probe the download HTTP server (port 8083) — the bot pods call. The /health
# endpoint on port 8080 only reflects redis reachability and starts listening
# before the download server does.
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
  CMD python3 -c "import socket; socket.create_connection(('localhost', 8083), timeout=5).close()"

ENTRYPOINT ["/entrypoint.sh"]
CMD ["/opt/discord/cnf/discord.cnf"]
